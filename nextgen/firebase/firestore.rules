rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/privado/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Users: each user document keyed by UID
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false; // account deletion handled via Admin SDK or Authentication flows
    }

    match /vagas/{vagaId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.empresaId == request.auth.uid
        && request.resource.data.empresaNome is string
        && request.resource.data.titulo is string
        && request.resource.data.descricao is string
        && request.resource.data.requisitos is string
        && request.resource.data.modalidade is string
        && request.resource.data.local is string
        && request.resource.data.status in ["aberta", "fechada"];
      allow update, delete: if request.auth != null && resource.data.empresaId == request.auth.uid;
    }

    // Posts collection
    match /posts/{postId} {
      allow read: if true; // public feed

      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && (request.resource.data.kind in ["post","vaga","evento"]);

      allow update: if request.auth != null && (
        (
          resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.content is string
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["likes", "likesCount", "commentsCount"])
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.content == resource.data.content
          && request.resource.data.kind == resource.data.kind
        )
      );

      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0;
        allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
      }
    }

    // Applications
    match /applications/{applicationId} {
      allow read: if request.auth != null && (resource.data.fromUserId == request.auth.uid || resource.data.toCompanyId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.toCompanyId is string
        && request.resource.data.vagaId is string
        && request.resource.data.message is string
        && request.resource.data.status in ["pending", "reviewed", "rejected", "hired"];
      allow update: if request.auth != null
        && resource.data.toCompanyId == request.auth.uid
        && request.resource.data.fromUserId == resource.data.fromUserId
        && request.resource.data.toCompanyId == resource.data.toCompanyId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "read"]);
      allow delete: if false;
    }

    // Proposals
    match /proposals/{proposalId} {
      allow read: if request.auth != null && (resource.data.toUserId == request.auth.uid || resource.data.fromCompanyId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.fromCompanyId == request.auth.uid && request.resource.data.fromCompanyName is string && request.resource.data.toUserId is string && request.resource.data.message is string;
      allow update: if request.auth != null
        && resource.data.toUserId == request.auth.uid
        && request.resource.data.toUserId == resource.data.toUserId
        && request.resource.data.fromCompanyId == resource.data.fromCompanyId
        && request.resource.data.fromCompanyName == resource.data.fromCompanyName
        && request.resource.data.message == resource.data.message
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "read"])
        && (
          request.resource.data.status == resource.data.status
          || request.resource.data.status in ["accepted", "rejected"]
        )
        && request.resource.data.read == true;
      allow delete: if false;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profileText(data, key, maxSize) {
      return data.get(key, "") is string && data.get(key, "").size() <= maxSize;
    }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function validReason(data) {
      return data.reason is string && data.reason.size() >= 10 && data.reason.size() <= 1000
        && data.adminUid == request.auth.uid && data.createdAt == request.time;
    }
    function verifiedCompany(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.tipoConta == "empresa"
        && get(/databases/$(database)/documents/users/$(uid)).data.companyStatus == "verified";
    }

    // These documents are directory-safe only after the one-time migration removes email/resumeUrl.
    match /users/{userId} {
      function validProfileEdit() {
        let data = request.resource.data;
        let changed = data.diff(resource.data).affectedKeys();
        return data.atualizadoEm == request.time
          && ((resource.data.tipoConta == "estudante" && changed.hasOnly(["titulo", "instituicao", "descricao", "github", "linkedin", "portfolio", "skills", "atualizadoEm"])
            && profileText(data, "titulo", 500) && profileText(data, "instituicao", 500)
            && profileText(data, "github", 500) && profileText(data, "portfolio", 500)
            && data.get("skills", []) is list && data.get("skills", []).size() <= 40)
          || (resource.data.tipoConta == "empresa" && changed.hasOnly(["nome", "ramo", "descricao", "site", "linkedin", "tagline", "localizacao", "atualizadoEm"])
            && profileText(data, "nome", 500) && data.nome.size() > 0 && profileText(data, "ramo", 500)
            && profileText(data, "site", 500) && profileText(data, "tagline", 500) && profileText(data, "localizacao", 500)))
          && profileText(data, "descricao", 3000) && profileText(data, "linkedin", 500);
      }
      allow update: if signedIn() && request.auth.uid == userId && validProfileEdit();
      allow read: if signedIn();
      allow create, update, delete: if false; // trusted Functions only
      allow update: if isAdmin() && resource.data.tipoConta == "empresa"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["companyStatus", "companyReviewedAt", "companyReviewedBy", "companyReviewAuditId"])
        && request.resource.data.companyStatus in ["pending", "verified", "rejected"]
        && request.resource.data.companyReviewedBy == request.auth.uid
        && request.resource.data.companyReviewedAt == request.time
        && !exists(/databases/$(database)/documents/adminAudit/$(request.resource.data.companyReviewAuditId))
        && getAfter(/databases/$(database)/documents/adminAudit/$(request.resource.data.companyReviewAuditId)).data.action == "companyAuthorization"
        && getAfter(/databases/$(database)/documents/adminAudit/$(request.resource.data.companyReviewAuditId)).data.targetId == userId
        && getAfter(/databases/$(database)/documents/adminAudit/$(request.resource.data.companyReviewAuditId)).data.status == request.resource.data.companyStatus
        && getAfter(/databases/$(database)/documents/adminAudit/$(request.resource.data.companyReviewAuditId)).data.createdAt == request.time;
      match /privado/{document=**} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow read: if isAdmin();
        allow write: if false; // trusted Functions only
      }
      match /advertencias/{warningId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow read: if isAdmin();
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(["reason", "adminUid", "createdAt", "readAt"])
          && validReason(request.resource.data) && request.resource.data.readAt == null
          && exists(/databases/$(database)/documents/users/$(userId))
          && getAfter(/databases/$(database)/documents/adminAudit/$("warning_" + userId + "_" + warningId)).data.action == "warning"
          && getAfter(/databases/$(database)/documents/adminAudit/$("warning_" + userId + "_" + warningId)).data.targetId == userId
          && getAfter(/databases/$(database)/documents/adminAudit/$("warning_" + userId + "_" + warningId)).data.reason == request.resource.data.reason
          && getAfter(/databases/$(database)/documents/adminAudit/$("warning_" + userId + "_" + warningId)).data.createdAt == request.time;
        allow create, delete: if false;
        allow update: if signedIn() && request.auth.uid == userId
          && resource.data.readAt == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readAt"])
          && request.resource.data.readAt == request.time;
      }
    }
    match /admins/{adminId} {
      allow get: if signedIn() && request.auth.uid == adminId;
      allow list, write: if false;
    }
    match /adminAudit/{eventId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validReason(request.resource.data)
        && request.resource.data.action in ["companyAuthorization", "deleteComment", "warning"]
        && request.resource.data.targetId is string;
      allow update, delete: if false;
    }
    match /resumeAccess/{studentUid}/companies/{companyUid} {
      allow read: if signedIn() && (request.auth.uid == studentUid || request.auth.uid == companyUid);
      allow create, update: if signedIn() && request.auth.uid in [studentUid, companyUid]
        && verifiedCompany(companyUid)
        && request.resource.data.keys().hasOnly(["applicationId", "grantedAt"])
        && request.resource.data.grantedAt == request.time
        && getAfter(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.fromUserId == studentUid
        && getAfter(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.toCompanyId == companyUid;
      allow delete: if false;
    }
    match /desafioSegredos/{challengeId} { allow read, write: if false; }
    match /resumes/{studentUid} {
      allow get: if signedIn() && (request.auth.uid == studentUid || (verifiedCompany(request.auth.uid)
        && exists(/databases/$(database)/documents/resumeAccess/$(studentUid)/companies/$(request.auth.uid))));
      allow create, update: if signedIn() && request.auth.uid == studentUid
        && request.resource.data.keys().hasOnly(["path", "updatedAt"])
        && request.resource.data.path is string
        && request.resource.data.path.matches("curriculos/" + studentUid + "/[^/]+[.]pdf")
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == studentUid;
    }

    match /vagas/{vagaId} {
      allow read: if signedIn();
      allow create, delete: if false; // created by Functions
      allow update: if signedIn() && resource.data.empresaId == request.auth.uid
        && verifiedCompany(request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
        && request.resource.data.status in ["aberta", "fechada"];
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.kind in ["post", "vaga", "evento"]
        && (request.resource.data.kind != "vaga" || verifiedCompany(request.auth.uid));
      allow update: if signedIn() && (
        (resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.kind == resource.data.kind
          && (resource.data.kind != "vaga" || verifiedCompany(request.auth.uid))
          && request.resource.data.content is string)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["likes", "likesCount", "commentsCount"])
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.content == resource.data.content
          && request.resource.data.kind == resource.data.kind)
      );
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["commentsCount"])
        && request.resource.data.commentsCount is number && request.resource.data.commentsCount >= 0;
      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.authorId == request.auth.uid
          && request.resource.data.content is string && request.resource.data.content.size() > 0;
        allow update, delete: if signedIn() && resource.data.authorId == request.auth.uid;
        allow delete: if isAdmin()
          && !exists(/databases/$(database)/documents/adminAudit/$("comment_" + postId + "_" + commentId))
          && getAfter(/databases/$(database)/documents/adminAudit/$("comment_" + postId + "_" + commentId)).data.action == "deleteComment"
          && getAfter(/databases/$(database)/documents/adminAudit/$("comment_" + postId + "_" + commentId)).data.targetId == commentId
          && getAfter(/databases/$(database)/documents/adminAudit/$("comment_" + postId + "_" + commentId)).data.postId == postId
          && getAfter(/databases/$(database)/documents/adminAudit/$("comment_" + postId + "_" + commentId)).data.createdAt == request.time;
      }
    }

    match /applications/{applicationId} {
      function validApplication() {
        let data = request.resource.data;
        let vacancy = get(/databases/$(database)/documents/vagas/$(data.vagaId)).data;
        let student = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        return data.keys().hasOnly(["fromUserId", "fromUserName", "toCompanyId", "toCompanyName", "vagaId", "role", "message", "status", "read", "createdAt"])
          && student.tipoConta == "estudante" && data.fromUserId == request.auth.uid
          && data.fromUserName == student.nome
          && applicationId == request.auth.uid + "_" + data.vagaId
          && vacancy.status == "aberta" && data.toCompanyId == vacancy.empresaId
          && verifiedCompany(data.toCompanyId) && data.role == vacancy.titulo
          && data.toCompanyName == vacancy.empresaNome
          && data.message is string && data.message.size() > 0 && data.message.size() <= 2000
          && data.status == "pending" && data.read == false && data.createdAt == request.time;
      }
      allow create: if signedIn() && validApplication();
      allow read: if isAdmin();
      allow read: if signedIn() && (resource.data.fromUserId == request.auth.uid || (resource.data.toCompanyId == request.auth.uid && verifiedCompany(request.auth.uid)));
      allow create, delete: if false; // created by Functions; prevents forged applications/grants
      allow update: if signedIn() && resource.data.toCompanyId == request.auth.uid
        && verifiedCompany(request.auth.uid)
        && request.resource.data.fromUserId == resource.data.fromUserId
        && request.resource.data.toCompanyId == resource.data.toCompanyId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "read"])
        && request.resource.data.status in ["pending", "reviewed", "rejected", "hired"]
        && request.resource.data.read is bool;
    }
    match /proposals/{proposalId} {
      allow create: if signedIn() && verifiedCompany(request.auth.uid)
        && request.resource.data.keys().hasOnly(["fromCompanyId", "fromCompanyName", "toUserId", "role", "message", "requirements", "status", "read", "createdAt"])
        && request.resource.data.fromCompanyId == request.auth.uid
        && request.resource.data.fromCompanyName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.nome
        && get(/databases/$(database)/documents/users/$(request.resource.data.toUserId)).data.tipoConta == "estudante"
        && request.resource.data.role is string && request.resource.data.role.size() > 0 && request.resource.data.role.size() <= 160
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 2000
        && request.resource.data.requirements is string && request.resource.data.requirements.size() <= 2000
        && request.resource.data.status == "pending" && request.resource.data.read == false
        && request.resource.data.createdAt == request.time;
      allow read: if signedIn() && (resource.data.toUserId == request.auth.uid || (resource.data.fromCompanyId == request.auth.uid && verifiedCompany(request.auth.uid)));
      allow create, delete: if false; // created by Functions after company verification
      allow update: if signedIn() && resource.data.toUserId == request.auth.uid
        && request.resource.data.toUserId == resource.data.toUserId
        && request.resource.data.fromCompanyId == resource.data.fromCompanyId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "read"])
        && request.resource.data.status in ["pending", "accepted", "rejected"]
        && request.resource.data.read is bool;
    }

    match /desafios/{id} {
      allow read: if signedIn(); // question docs must not contain answer keys
      allow create, delete: if false; // created/deleted only by trusted Functions/admin workflows
      allow update: if signedIn() && resource.data.empresaId == request.auth.uid
        && verifiedCompany(request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
        && request.resource.data.status in ["aberto", "fechado"];
    }
    match /conquistas/{id} {
      allow read: if signedIn();
      allow create, update, delete: if false; // score and points are server-generated
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profileText(data, key, maxSize) {
      return data.get(key, "") is string && data.get(key, "").size() <= maxSize;
    }
    function registrationAge(dob) {
      return request.time.year() - dob.year()
        - ((request.time.month() < dob.month() || (request.time.month() == dob.month() && request.time.day() < dob.day())) ? 1 : 0);
    }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function validReason(data) {
      return data.reason is string && data.reason.size() >= 10 && data.reason.size() <= 1000
        && data.adminUid == request.auth.uid && data.createdAt == request.time;
    }
    function verifiedCompany(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.tipoConta == "empresa"
        && get(/databases/$(database)/documents/users/$(uid)).data.companyStatus == "verified";
    }
    function chatEligible(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.tipoConta == "estudante" || verifiedCompany(uid);
    }
    function chatPair(members) {
      return members is list && members.size() == 2 && members[0] is string && members[1] is string
        && members[0] != members[1] && chatEligible(members[0]) && chatEligible(members[1])
        && (get(/databases/$(database)/documents/users/$(members[0])).data.tipoConta == "estudante"
          || get(/databases/$(database)/documents/users/$(members[1])).data.tipoConta == "estudante");
    }
    match /conversations/{conversationId} {
      function participant() { return signedIn() && request.auth.uid in resource.data.members; }
      function ownReadChange() {
        return request.resource.data.readAt.diff(resource.data.readAt).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.readAt[request.auth.uid] == request.time;
      }
      function validSend() {
        let before = resource.data;
        let after = request.resource.data;
        let message = getAfter(/databases/$(database)/documents/conversations/$(conversationId)/messages/$(after.lastMessageId)).data;
        return before.status == "accepted" && before.blockedBy.size() == 0 && chatPair(before.members)
          && after.diff(before).affectedKeys().hasOnly(["lastMessageId", "lastMessage", "lastSenderId", "updatedAt", "readAt"])
          && !exists(/databases/$(database)/documents/conversations/$(conversationId)/messages/$(after.lastMessageId))
          && message.senderId == request.auth.uid && message.createdAt == request.time
          && after.lastMessage == message.text && after.lastSenderId == request.auth.uid
          && after.updatedAt == request.time && ownReadChange();
      }
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/conversations/$(conversationId)) || participant());
      allow list: if participant();
      allow create: if signedIn() && chatPair(request.resource.data.members)
        && request.resource.data.members[0].matches("[^|/]{1,128}") && request.resource.data.members[1].matches("[^|/]{1,128}")
        && !existsAfter(/databases/$(database)/documents/conversations/$(request.resource.data.members[1] + "|" + request.resource.data.members[0]))
        && request.auth.uid in request.resource.data.members
        && conversationId == request.resource.data.members[0] + "|" + request.resource.data.members[1]
        && request.resource.data.keys().hasOnly(["members", "createdBy", "status", "intro", "blockedBy", "readAt", "createdAt", "updatedAt", "lastMessageId", "lastMessage", "lastSenderId"])
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.status == "pending"
        && request.resource.data.intro is string && request.resource.data.intro.size() > 0 && request.resource.data.intro.size() <= 500
        && request.resource.data.blockedBy == [] && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time && request.resource.data.lastSenderId == request.auth.uid
        && request.resource.data.lastMessage == request.resource.data.intro && request.resource.data.lastMessageId == ""
        && request.resource.data.readAt.keys().hasAll(request.resource.data.members)
        && request.resource.data.readAt.keys().hasOnly(request.resource.data.members)
        && request.resource.data.readAt[request.auth.uid] == request.time
        && (request.resource.data.readAt[request.resource.data.members[0]] == null || request.resource.data.readAt[request.resource.data.members[1]] == null);
      allow update: if participant() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readAt"]) && ownReadChange())
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
          && resource.data.status == "pending" && request.auth.uid != resource.data.createdBy
          && resource.data.blockedBy.size() == 0 && chatPair(resource.data.members)
          && request.resource.data.status in ["accepted", "declined"])
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["blockedBy"])
          && request.resource.data.blockedBy is list
          && request.resource.data.blockedBy.toSet().size() == request.resource.data.blockedBy.size()
          && request.resource.data.blockedBy.hasOnly(resource.data.members)
          && request.resource.data.blockedBy.removeAll([request.auth.uid]) == resource.data.blockedBy.removeAll([request.auth.uid]))
        || validSend());
      allow delete: if false;
      match /messages/{messageId} {
        function parent() { return get(/databases/$(database)/documents/conversations/$(conversationId)).data; }
        allow read: if signedIn() && request.auth.uid in parent().members;
        allow create: if signedIn() && request.auth.uid in parent().members && parent().status == "accepted"
          && parent().blockedBy.size() == 0 && chatPair(parent().members)
          && request.resource.data.keys().hasOnly(["senderId", "text", "createdAt"])
          && request.resource.data.senderId == request.auth.uid && request.resource.data.createdAt == request.time
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.lastMessageId == messageId
          && getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.updatedAt == request.time;
        allow update, delete: if false;
      }
    }
    match /chatReports/{reportId} {
      function validReport() {
        let data = request.resource.data;
        let chat = get(/databases/$(database)/documents/conversations/$(data.conversationId)).data;
        return data.keys().hasOnly(["conversationId", "reporterId", "reportedId", "reason", "createdAt", "status", "messageId", "evidence"])
          && data.reporterId == request.auth.uid && request.auth.uid in chat.members
          && data.reportedId in chat.members && data.reportedId != request.auth.uid
          && reportId == data.conversationId + "_" + request.auth.uid
          && data.reason is string && data.reason.size() >= 10 && data.reason.size() <= 1000
          && data.createdAt == request.time && data.status == "open"
          && ((data.messageId == "" && data.evidence == "")
            || (get(/databases/$(database)/documents/conversations/$(data.conversationId)/messages/$(data.messageId)).data.senderId == data.reportedId
              && get(/databases/$(database)/documents/conversations/$(data.conversationId)/messages/$(data.messageId)).data.text == data.evidence));
      }
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/chatReports/$(reportId)) || resource.data.reporterId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && validReport();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "reviewedAt", "reviewedBy"])
        && request.resource.data.status in ["reviewed", "resolved"] && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewedBy == request.auth.uid;
      allow delete: if false;
    }

    // These documents are directory-safe only after the one-time migration removes email/resumeUrl.
    match /users/{userId} {
      function validRegistration() {
        let data = request.resource.data;
        return signedIn() && request.auth.uid == userId
          && data.uid == userId && data.nome is string && data.nome.size() > 0 && data.nome.size() <= 120
          && data.createdAt == request.time
          && ((data.tipoConta == "estudante" && data.keys().hasOnly(["uid", "nome", "tipoConta", "createdAt"]))
            || (data.tipoConta == "empresa" && data.keys().hasOnly(["uid", "nome", "tipoConta", "ramo", "companyStatus", "createdAt"])
              && data.companyStatus == "pending" && data.ramo is string && data.ramo.size() <= 120))
          && getAfter(/databases/$(database)/documents/users/$(userId)/privado/dados).data.createdAt == request.time;
      }
      allow create: if validRegistration();
      function validProfileEdit() {
        let data = request.resource.data;
        let changed = data.diff(resource.data).affectedKeys();
        return data.atualizadoEm == request.time
          && ((resource.data.tipoConta == "estudante" && changed.hasOnly(["titulo", "instituicao", "descricao", "github", "linkedin", "portfolio", "skills", "atualizadoEm"])
            && profileText(data, "titulo", 500) && profileText(data, "instituicao", 500)
            && profileText(data, "github", 500) && profileText(data, "portfolio", 500)
            && data.get("skills", []) is list && data.get("skills", []).size() <= 40)
          || (resource.data.tipoConta == "empresa" && changed.hasOnly(["nome", "ramo", "descricao", "site", "linkedin", "tagline", "localizacao", "atualizadoEm"])
            && profileText(data, "nome", 500) && data.nome.size() > 0 && profileText(data, "ramo", 500)
            && profileText(data, "site", 500) && profileText(data, "tagline", 500) && profileText(data, "localizacao", 500)))
          && profileText(data, "descricao", 3000) && profileText(data, "linkedin", 500);
      }
      allow update: if signedIn() && request.auth.uid == userId && validProfileEdit();
      allow read: if signedIn();
      allow create, update, delete: if false; // trusted Functions only
      allow update: if isAdmin() && resource.data.tipoConta == "empresa"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["companyStatus", "companyReviewedAt", "companyReviewedBy", "companyReviewAuditId"])
        && request.resource.data.companyStatus in ["pending", "verified", "rejected"]
        && request.resource.data.companyReviewedBy == request.auth.uid
        && request.resource.data.companyReviewedAt == request.time
        && !exists(/databases/$(database)/documents/adminAudit/$(request.resource.data.companyReviewAuditId))
        && getAfter(/databases/$(database)/documents/adminAudit/$(request.resource.data.companyReviewAuditId)).data.action == "companyAuthorization"
        && getAfter(/databases/$(database)/documents/adminAudit/$(request.resource.data.companyReviewAuditId)).data.targetId == userId
        && getAfter(/databases/$(database)/documents/adminAudit/$(request.resource.data.companyReviewAuditId)).data.status == request.resource.data.companyStatus
        && getAfter(/databases/$(database)/documents/adminAudit/$(request.resource.data.companyReviewAuditId)).data.createdAt == request.time;
      match /privado/{document} {
        allow create: if signedIn() && request.auth.uid == userId && document == "dados"
          && !exists(/databases/$(database)/documents/users/$(userId))
          && request.resource.data.keys().hasOnly(["dataNascimento", "cpf", "cnpj", "responsavel", "createdAt"])
          && request.resource.data.createdAt == request.time && request.resource.data.responsavel == null
          && getAfter(/databases/$(database)/documents/users/$(userId)).data.createdAt == request.time
          && ((getAfter(/databases/$(database)/documents/users/$(userId)).data.tipoConta == "estudante"
            && request.resource.data.cpf is string && request.resource.data.cpf.matches("[0-9]{11}")
            && request.resource.data.cnpj == null && request.resource.data.dataNascimento is timestamp
            && registrationAge(request.resource.data.dataNascimento) >= 16 && registrationAge(request.resource.data.dataNascimento) <= 120)
          || (getAfter(/databases/$(database)/documents/users/$(userId)).data.tipoConta == "empresa"
            && request.resource.data.cnpj is string && request.resource.data.cnpj.matches("[0-9]{14}")
            && request.resource.data.cpf == null && request.resource.data.dataNascimento == null));
        allow read: if signedIn() && request.auth.uid == userId;
        allow read: if isAdmin();
        allow write: if false; // trusted Functions only
      }
      match /advertencias/{warningId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow read: if isAdmin();
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(["reason", "adminUid", "createdAt", "readAt"])
          && validReason(request.resource.data) && request.resource.data.readAt == null
          && exists(/databases/$(database)/documents/users/$(userId))
          && getAfter(/databases/$(database)/documents/adminAudit/$("warning_" + userId + "_" + warningId)).data.action == "warning"
          && getAfter(/databases/$(database)/documents/adminAudit/$("warning_" + userId + "_" + warningId)).data.targetId == userId
          && getAfter(/databases/$(database)/documents/adminAudit/$("warning_" + userId + "_" + warningId)).data.reason == request.resource.data.reason
          && getAfter(/databases/$(database)/documents/adminAudit/$("warning_" + userId + "_" + warningId)).data.createdAt == request.time;
        allow create, delete: if false;
        allow update: if signedIn() && request.auth.uid == userId
          && resource.data.readAt == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readAt"])
          && request.resource.data.readAt == request.time;
      }
    }
    match /admins/{adminId} {
      allow get: if signedIn() && request.auth.uid == adminId;
      allow list, write: if false;
    }
    match /adminAudit/{eventId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validReason(request.resource.data)
        && request.resource.data.action in ["companyAuthorization", "deleteComment", "warning"]
        && request.resource.data.targetId is string;
      allow update, delete: if false;
    }
    match /resumeAccess/{studentUid}/companies/{companyUid} {
      allow read: if signedIn() && (request.auth.uid == studentUid || request.auth.uid == companyUid);
      allow create, update: if signedIn() && request.auth.uid in [studentUid, companyUid]
        && verifiedCompany(companyUid)
        && request.resource.data.keys().hasOnly(["applicationId", "grantedAt"])
        && request.resource.data.grantedAt == request.time
        && getAfter(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.fromUserId == studentUid
        && getAfter(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.toCompanyId == companyUid;
      allow delete: if false;
    }
    match /desafioSegredos/{challengeId} { allow read, write: if false; }
    match /desafioTentativas/{attemptId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    match /resumes/{studentUid} {
      allow get: if signedIn() && (request.auth.uid == studentUid || (verifiedCompany(request.auth.uid)
        && exists(/databases/$(database)/documents/resumeAccess/$(studentUid)/companies/$(request.auth.uid))));
      allow create, update: if signedIn() && request.auth.uid == studentUid
        && request.resource.data.keys().hasOnly(["path", "updatedAt"])
        && request.resource.data.path is string
        && request.resource.data.path.matches("curriculos/" + studentUid + "/[^/]+[.]pdf")
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == studentUid;
    }

    match /vagas/{vagaId} {
      allow create: if signedIn() && verifiedCompany(request.auth.uid)
        && request.resource.data.keys().hasOnly(["empresaId", "empresaNome", "titulo", "descricao", "requisitos", "modalidade", "local", "status", "createdAt"])
        && request.resource.data.empresaId == request.auth.uid
        && request.resource.data.empresaNome == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.nome
        && request.resource.data.titulo is string && request.resource.data.titulo.size() > 0 && request.resource.data.titulo.size() <= 160
        && request.resource.data.descricao is string && request.resource.data.descricao.size() > 0 && request.resource.data.descricao.size() <= 5000
        && request.resource.data.requisitos is string && request.resource.data.requisitos.size() > 0 && request.resource.data.requisitos.size() <= 3000
        && request.resource.data.local is string && request.resource.data.local.size() > 0 && request.resource.data.local.size() <= 200
        && request.resource.data.modalidade in ["Presencial", "Híbrido", "Remoto"]
        && request.resource.data.status == "aberta" && request.resource.data.createdAt == request.time;
      allow read: if signedIn();
      allow create, delete: if false; // created by Functions
      allow update: if signedIn() && resource.data.empresaId == request.auth.uid
        && verifiedCompany(request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
        && request.resource.data.status in ["aberta", "fechada"];
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.kind in ["post", "vaga", "evento"]
        && (request.resource.data.kind != "vaga" || verifiedCompany(request.auth.uid));
      allow update: if signedIn() && (
        (resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.kind == resource.data.kind
          && (resource.data.kind != "vaga" || verifiedCompany(request.auth.uid))
          && request.resource.data.content is string)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["likes", "likesCount", "commentsCount"])
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.content == resource.data.content
          && request.resource.data.kind == resource.data.kind)
      );
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["commentsCount"])
        && request.resource.data.commentsCount is number && request.resource.data.commentsCount >= 0;
      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.authorId == request.auth.uid
          && request.resource.data.content is string && request.resource.data.content.size() > 0;
        allow update, delete: if signedIn() && resource.data.authorId == request.auth.uid;
        allow delete: if isAdmin()
          && !exists(/databases/$(database)/documents/adminAudit/$("comment_" + postId + "_" + commentId))
          && getAfter(/databases/$(database)/documents/adminAudit/$("comment_" + postId + "_" + commentId)).data.action == "deleteComment"
          && getAfter(/databases/$(database)/documents/adminAudit/$("comment_" + postId + "_" + commentId)).data.targetId == commentId
          && getAfter(/databases/$(database)/documents/adminAudit/$("comment_" + postId + "_" + commentId)).data.postId == postId
          && getAfter(/databases/$(database)/documents/adminAudit/$("comment_" + postId + "_" + commentId)).data.createdAt == request.time;
      }
    }

    match /applications/{applicationId} {
      function validApplication() {
        let data = request.resource.data;
        let vacancy = get(/databases/$(database)/documents/vagas/$(data.vagaId)).data;
        let student = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        return data.keys().hasOnly(["fromUserId", "fromUserName", "toCompanyId", "toCompanyName", "vagaId", "role", "message", "status", "read", "createdAt"])
          && student.tipoConta == "estudante" && data.fromUserId == request.auth.uid
          && data.fromUserName == student.nome
          && applicationId == request.auth.uid + "_" + data.vagaId
          && vacancy.status == "aberta" && data.toCompanyId == vacancy.empresaId
          && verifiedCompany(data.toCompanyId) && data.role == vacancy.titulo
          && data.toCompanyName == vacancy.empresaNome
          && data.message is string && data.message.size() > 0 && data.message.size() <= 2000
          && data.status == "pending" && data.read == false && data.createdAt == request.time;
      }
      allow create: if signedIn() && validApplication();
      allow read: if isAdmin();
      allow read: if signedIn() && (resource.data.fromUserId == request.auth.uid || (resource.data.toCompanyId == request.auth.uid && verifiedCompany(request.auth.uid)));
      allow create, delete: if false; // created by Functions; prevents forged applications/grants
      allow update: if signedIn() && resource.data.toCompanyId == request.auth.uid
        && verifiedCompany(request.auth.uid)
        && request.resource.data.fromUserId == resource.data.fromUserId
        && request.resource.data.toCompanyId == resource.data.toCompanyId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "read"])
        && request.resource.data.status in ["pending", "reviewed", "rejected", "hired"]
        && request.resource.data.read is bool;
    }
    match /proposals/{proposalId} {
      allow create: if signedIn() && verifiedCompany(request.auth.uid)
        && request.resource.data.keys().hasOnly(["fromCompanyId", "fromCompanyName", "toUserId", "role", "message", "requirements", "status", "read", "createdAt"])
        && request.resource.data.fromCompanyId == request.auth.uid
        && request.resource.data.fromCompanyName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.nome
        && get(/databases/$(database)/documents/users/$(request.resource.data.toUserId)).data.tipoConta == "estudante"
        && request.resource.data.role is string && request.resource.data.role.size() > 0 && request.resource.data.role.size() <= 160
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 2000
        && request.resource.data.requirements is string && request.resource.data.requirements.size() <= 2000
        && request.resource.data.status == "pending" && request.resource.data.read == false
        && request.resource.data.createdAt == request.time;
      allow read: if signedIn() && (resource.data.toUserId == request.auth.uid || (resource.data.fromCompanyId == request.auth.uid && verifiedCompany(request.auth.uid)));
      allow create, delete: if false; // created by Functions after company verification
      allow update: if signedIn() && resource.data.toUserId == request.auth.uid
        && request.resource.data.toUserId == resource.data.toUserId
        && request.resource.data.fromCompanyId == resource.data.fromCompanyId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "read"])
        && request.resource.data.status in ["pending", "accepted", "rejected"]
        && request.resource.data.read is bool;
    }

    match /desafios/{id} {
      allow read: if signedIn() && (resource.data.get("scoringVersion", 0) == 2 || isAdmin());
      allow create, delete: if false; // created/deleted only by trusted Functions/admin workflows
      allow update: if signedIn() && resource.data.empresaId == request.auth.uid
        && verifiedCompany(request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
        && request.resource.data.status in ["aberto", "fechado"];
    }
    match /conquistas/{id} {
      allow read: if signedIn() && (resource.data.get("scoringVersion", 0) == 2 || isAdmin());
      allow create, update, delete: if false; // score and points are server-generated
    }
  }
}
